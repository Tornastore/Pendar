+	if not game.pas_game_over:
+		if game._pas_my_turn():
+			if game.pas_selected < 0:
+				app._hint("یک کارت انتخاب کنید", 740, app.ACCENT)
+		else:
+			app._hint("حریف در حال بازی…", 740, app.TEXT_DIM)

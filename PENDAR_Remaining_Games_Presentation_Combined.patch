+        for method in case["critical"]:
+            assert re.search(rf"^func\s+{method}\(", rules, re.M), (game_id, method)
+        assert not re.search(rf"^\s*game\.{case['prefix']}[A-Za-z0-9_]*\s*=(?!=)", presenter, re.M), game_id
+
